# Copy this to .env.local (or run `vercel env pull .env.local`) and edit
SUPER_ADMIN_USER=admin
SUPER_ADMIN_PWD=changeme
SESSION_SECRET=replace-with-secure-secret
# Injected automatically by the Neon marketplace integration via `vercel env pull` —
# only set this by hand for a non-Vercel Postgres instance.
DATABASE_URL=
# Injected automatically by the Vercel Blob store integration.
BLOB_READ_WRITE_TOKEN=
# Gmail SMTP, used for every outbound email (approval/temp-password/admin/event-reminder).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Checked against the Authorization: Bearer header on GET /cron/event-reminders.
CRON_SECRET=
# Your deployment's own base URL (e.g. https://your-app.vercel.app), used only to build full
# links in emails sent outside of any request (no req.protocol/req.get('host') available there).
PUBLIC_BASE_URL=
